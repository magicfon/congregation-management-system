    "check:line-pairing": "node scripts/check-line-pairing.cjs",
    "check:map-allocation": "node scripts/check-map-allocation.cjs",
    "check:map-requests": "node scripts/check-map-requests.cjs",
    "check:territory-report": "node scripts/check-territory-report.cjs",
