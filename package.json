    "date-fns": "^3.0.0",
    "googleapis": "^171.4.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lucide-react": "^0.577.0",
    "next": "^14.2.28",
    "next-auth": "^4.24.13",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.20.0",
