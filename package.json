    "db:ministry-visits": "node scripts/execute-db-sql.cjs prisma/ministry-visits.sql",
    "db:line-notifications": "node scripts/execute-db-sql.cjs prisma/line-notifications.sql",
    "db:personal-reminders": "node scripts/execute-db-sql.cjs prisma/personal-reminders.sql",
    "db:personal-territory": "node scripts/execute-db-sql.cjs prisma/personal-territory.sql",
    "db:member-deletion": "node scripts/execute-db-sql.cjs prisma/member-deletion.sql",
    "db:pending-line": "node scripts/execute-db-sql.cjs prisma/pending-line-identities.sql",
    "db:bulletin-announcements": "node scripts/execute-db-sql.cjs prisma/bulletin-announcements.sql",
    "db:service-roster": "node scripts/execute-db-sql.cjs prisma/service-roster.sql",
    "db:do-not-visit": "node scripts/execute-db-sql.cjs prisma/do-not-visit.sql",
    "db:dispatch-undo": "node scripts/execute-db-sql.cjs prisma/dispatch-undo.sql"
  },
  "dependencies": {
