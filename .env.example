# Congregation Management System environment variables
# Copy to .env.local for local development, and set the same keys in Vercel Project Settings → Environment Variables.
# Do not commit real secret values.

# App URL
# Local: http://localhost:3000
# Production: https://<your-vercel-domain>
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Project Settings → API → anon public key
# Required by legacy/client helpers. Safe to expose, but still configure via env.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"

# Project Settings → API → service_role key
# Server-side only. Never expose in browser or commit real value.
SUPABASE_SERVICE_KEY="<supabase-service-role-key>"

# NextAuth
# Production must be the public canonical URL, no trailing slash.
NEXTAUTH_URL="https://<your-vercel-domain>"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<random-32-byte-secret>"

# Optional: LINE login
# Only set these if LINE OAuth login is enabled. Credentials login works without them.
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""

# Optional: Google Sheets daily sync script only
GOOGLE_SPREADSHEET_ID=""
GOOGLE_SHEETS_CREDENTIALS=""
